NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Absolute path to the Firebase service-account JSON, kept OUTSIDE this project.
FIREBASE_SERVICE_ACCOUNT_PATH=/data/data/com.termux/files/home/.config/arm-mcp/service-account.json
FIREBASE_PROJECT_ID=arm-galaxy-premium

# Generate long random secrets. Do not commit .env.
API_BEARER_TOKEN=replace_with_long_random_read_secret
ADMIN_MCP_BEARER_TOKEN=replace_with_different_long_random_admin_secret
ADMIN_API_KEY=replace_with_another_long_random_secret
ADMIN_TELEGRAM_IDS=123456789

TON_NETWORK=mainnet
ARM_JETTON_MASTER_ADDRESS=
TONAPI_BASE_URL=https://tonapi.io
TONAPI_API_KEY=
STONFI_BASE_URL=https://api.ston.fi
