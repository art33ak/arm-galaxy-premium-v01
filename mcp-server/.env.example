NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Firebase
FIREBASE_PROJECT_ID=arm-galaxy-premium
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json

# Authentication — use unique random secrets (32+ bytes)
API_BEARER_TOKEN=replace_with_long_random_secret
ADMIN_MCP_BEARER_TOKEN=replace_with_different_long_random_secret
ADMIN_API_KEY=replace_with_another_long_random_secret

TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=

# TON
TON_NETWORK=mainnet
ARM_JETTON_MASTER_ADDRESS=
TONAPI_BASE_URL=https://tonapi.io
TONAPI_API_KEY=

# STON.fi
STONFI_BASE_URL=https://api.ston.fi
STONFI_POOL_ADDRESS=

# Display only — not verified market price
ARM_DISPLAY_PRICE_USD=0.01
